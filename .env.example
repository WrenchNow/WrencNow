# ── Business rules ──────────────────────────────────────────────────
# Platform fee in basis points: 500 = 5%.
PLATFORM_FEE_BPS=500
# Featured mechanic subscription, cents per month.
FEATURED_PRICE_CENTS=2900
# Mechanic verification fee (covers the background check), refunded per completed job until fully returned.
VERIFICATION_FEE_CENTS=5000
VERIFICATION_REFUND_PER_JOB_CENTS=1000

# ── Stripe (TEST MODE until the business entity is set up) ─────────
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=
# From `stripe listen --forward-to localhost:3000/api/stripe/webhook` locally,
# or the webhook endpoint's signing secret in the Stripe dashboard.
STRIPE_WEBHOOK_SECRET=
# Connect webhooks (account.updated) use a separate endpoint secret in the dashboard.
# If you use one endpoint for both, leave this blank.
STRIPE_CONNECT_WEBHOOK_SECRET=

# ── Background checks (Checkr) ─────────────────────────────────────
CHECKR_API_KEY=
# https://api.checkr-staging.com for sandbox, https://api.checkr.com for live
CHECKR_API_BASE=https://api.checkr-staging.com
# Package slug from your Checkr account, e.g. tasker_standard / driver_pro
CHECKR_PACKAGE=tasker_standard
