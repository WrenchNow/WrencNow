# ── Business rules ──────────────────────────────────────────────────
# Platform fee in basis points: 500 = 5%.
PLATFORM_FEE_BPS=500
# Sponsored placement subscription, cents per month.
FEATURED_PRICE_CENTS=2900
# Mechanic onboarding fee (covers the background check): nothing up front; WrenchNow keeps this much
# from each completed job, on top of the platform fee, until the total is collected.
ONBOARDING_FEE_TOTAL_CENTS=5000
ONBOARDING_FEE_PER_JOB_CENTS=1000
# Card processing pass-through taken from the mechanic's share (covers Stripe's card + payout costs): 3.2% + 55¢.
PROCESSING_FEE_BPS=320
PROCESSING_FEE_CENTS=55
# Parts are billed at receipt cost plus this handling charge (to the mechanic). 500 = 5%.
PARTS_HANDLING_BPS=500
# Optional "typical dealer" labor comparison on profiles. Leave blank to hide; set it to a rate you've actually confirmed.
DEALER_LABOR_RATE_CENTS=
# Charged to a customer who doesn't respond within 15 min after the mechanic checks in at the address.
CUSTOMER_NO_SHOW_FEE_CENTS=2500
# Days after a job a customer can "Report a problem" (support mediates; WrenchNow offers no warranty).
ISSUE_REPORT_DAYS=30

# ── Stripe (TEST MODE until the business entity is set up) ─────────
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=
# From `stripe listen --forward-to localhost:3000/api/stripe/webhook` locally,
# or the webhook endpoint's signing secret in the Stripe dashboard.
STRIPE_WEBHOOK_SECRET=
# Connect webhooks (account.updated) use a separate endpoint secret in the dashboard.
# If you use one endpoint for both, leave this blank.
STRIPE_CONNECT_WEBHOOK_SECRET=

# ── Background checks (Checkr) ─────────────────────────────────────
CHECKR_API_KEY=
# https://api.checkr-staging.com for sandbox, https://api.checkr.com for live
CHECKR_API_BASE=https://api.checkr-staging.com
# Package slug from your Checkr account, e.g. tasker_standard / driver_pro
CHECKR_PACKAGE=tasker_standard

# ── Notifications ──────────────────────────────────────────────────
# Where admin alerts go (warranty claims, payment reports). Defaults to getwrenchnow11@gmail.com.
ADMIN_EMAIL=getwrenchnow11@gmail.com
# Email via Resend (optional — off until both are set). EMAIL_FROM must be on a domain verified in Resend.
RESEND_API_KEY=
EMAIL_FROM=
# Text messages via Twilio (optional — off until set). Use TWILIO_FROM or TWILIO_MESSAGING_SERVICE_SID.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=
TWILIO_MESSAGING_SERVICE_SID=
