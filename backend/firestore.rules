rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    // You are an admin if a document exists at admins/{your uid}. Create it once in the Firebase console.
    function isAdmin() {
      return signedIn() && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    // Online payments on? (Admin tab switch.) When on, only mechanics with Stripe payouts can quote.
    function paymentsOn() {
      return exists(/databases/$(database)/documents/config/site)
          && get(/databases/$(database)/documents/config/site).data.get('payments_on', false) == true;
    }

    match /config/{doc} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /admins/{uid} {
      allow get: if signedIn() && request.auth.uid == uid;   // lets the site check "am I an admin?"
      allow list, write: if false;                            // only editable in the console
    }

    // Public mechanic profiles: anyone can read, only an admin can publish or change them.
    match /mechanics/{id} {
      function changes() { return request.resource.data.diff(resource.data).affectedKeys(); }
      allow read: if true;
      allow create, delete: if isAdmin();
      allow update: if isAdmin()
        // A linked mechanic may edit their own public details (rate, bio, photo, travel area, pause)
        || (signedIn() && resource.data.owner_uid == request.auth.uid
            && changes().hasOnly(['bio', 'photo', 'rate_num', 'rate_display', 'available_now', 'avail_label', 'zip', 'radius_mi', 'geo_lat', 'geo_lng', 'diag_fee_cents', 'updated_at'])
            && (!changes().hasAny(['diag_fee_cents']) || request.resource.data.diag_fee_cents == null || (request.resource.data.diag_fee_cents is int && request.resource.data.diag_fee_cents >= 0 && request.resource.data.diag_fee_cents <= 50000))
            && (!changes().hasAny(['rate_num']) || (request.resource.data.rate_num is int && request.resource.data.rate_num >= 20 && request.resource.data.rate_num <= 500))
            && (!changes().hasAny(['bio']) || (request.resource.data.bio is string && request.resource.data.bio.size() <= 1500))
            && (!changes().hasAny(['photo']) || (request.resource.data.photo is string && request.resource.data.photo.size() <= 120000))
            && (!changes().hasAny(['radius_mi']) || request.resource.data.radius_mi in [10, 15, 25, 40]))
        // Linking: a signed-in user whose VERIFIED email matches the private record claims an unclaimed profile
        || (signedIn() && request.auth.token.email_verified == true
            && (!('owner_uid' in resource.data) || resource.data.owner_uid == '')
            && changes().hasOnly(['owner_uid'])
            && request.resource.data.owner_uid == request.auth.uid
            && exists(/databases/$(database)/documents/mechanic_private/$(resource.data.slug))
            && get(/databases/$(database)/documents/mechanic_private/$(resource.data.slug)).data.email.lower() == request.auth.token.email.lower());
    }

    // Mechanic email, phone, fee and payback status — never public.
    match /mechanic_private/{slug} {
      allow read, write: if isAdmin();
    }

    // Anyone can apply, but only as a pending, unpaid, unchecked application.
    match /mechanic_applications/{id} {
      allow create: if request.resource.data.status == 'pending'
                    && request.resource.data.fee_paid == false
                    && !('checks' in request.resource.data)
                    && !('mechanic_slug' in request.resource.data)
                    && !('background_status' in request.resource.data)
                    && !('checkr_requested' in request.resource.data)
                    && request.resource.data.service_level in ['basic', 'full']
                    && (!('photo' in request.resource.data) || (request.resource.data.photo is string && request.resource.data.photo.size() <= 120000))
                    && request.resource.data.name is string  && request.resource.data.name.size()  <= 80
                    && request.resource.data.email is string && request.resource.data.email.size() <= 120
                    && request.resource.data.bio is string   && request.resource.data.bio.size()   <= 1500
                    && request.resource.data.created_at == request.time;
      allow read, update, delete: if isAdmin();
    }

    // Customers create and see their own bookings, and may only mark them completed or cancelled.
    match /bookings/{id} {
      // A booking only exists because the customer accepted a real quote: price, day and time must match it
      function quote() { return get(/databases/$(database)/documents/requests/$(request.resource.data.request_id)/quotes/$(request.resource.data.mechanic_uid)).data; }
      allow create: if signedIn()
                    && request.resource.data.customer_id == request.auth.uid
                    && request.resource.data.status == 'confirmed'
                    && request.resource.data.request_id is string
                    && get(/databases/$(database)/documents/requests/$(request.resource.data.request_id)).data.customer_id == request.auth.uid
                    && quote().status == 'sent'
                    && quote().total_cents == request.resource.data.price_cents
                    && quote().date_iso == request.resource.data.booking_date_iso
                    && quote().time == request.resource.data.booking_time
                    && quote().mechanic_doc == request.resource.data.mechanic_doc
                    && request.resource.data.payment_status == (paymentsOn() ? 'needs_card' : 'pay_mechanic')
                    && !('final_cents' in request.resource.data) && !('paid_cents' in request.resource.data)
                    && request.resource.data['service'] is string && request.resource.data['service'].size() <= 300
                    && request.resource.data.address is string && request.resource.data.address.size() <= 300;
      allow read: if isAdmin() || (signedIn() && (resource.data.customer_id == request.auth.uid
                                                  || (resource.data.mechanic_uid != '' && resource.data.mechanic_uid == request.auth.uid)));
      allow update: if isAdmin() || (
                       signedIn()
                    && resource.data.customer_id == request.auth.uid
                    && resource.data.status in ['pending', 'confirmed']
                    && request.resource.data.status in ['completed', 'cancelled']
                    && request.resource.data.diff(resource.data).affectedKeys()
                         .hasOnly(['status', 'completed_at', 'cancelled_at', 'status_by'])
                    // with online payments the mechanic marks the work done, not the customer
                    && (request.resource.data.status == 'cancelled' || resource.data.get('payment_status', 'pay_mechanic') == 'pay_mechanic'))
        // Customer: pay now, or hold the payment by reporting a problem (only after the work is marked done)
        || (signedIn() && resource.data.customer_id == request.auth.uid
            && resource.data.status == 'completed' && resource.data.payment_status == 'card_saved'
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['payment_status', 'payment_requested_at', 'dispute_note', 'disputed_at'])
            && request.resource.data.payment_status in ['charge_now', 'disputed'])
        // Customer: the mechanic never came (the server only accepts it after the appointment time has passed)
        || (signedIn() && resource.data.customer_id == request.auth.uid
            && resource.data.status == 'confirmed' && request.resource.data.status == 'no_show'
            && request.resource.data.status_by == 'customer'
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'no_show_at', 'status_by']))
        // Customer: "my mechanic asked me to pay outside the app"
        || (signedIn() && resource.data.customer_id == request.auth.uid
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['offapp_report', 'offapp_report_at'])
            && request.resource.data.offapp_report is string && request.resource.data.offapp_report.size() > 0 && request.resource.data.offapp_report.size() <= 1000)
        // Customer: approve or reject the mechanic's revised price
        || (signedIn() && resource.data.customer_id == request.auth.uid
            && 'revision' in resource.data && resource.data.revision.status == 'pending'
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['final_cents', 'revision'])
            && request.resource.data.revision.total_cents == resource.data.revision.total_cents
            && ((request.resource.data.revision.status == 'approved' && request.resource.data.final_cents == resource.data.revision.total_cents)
                || (request.resource.data.revision.status == 'rejected' && request.resource.data.get('final_cents', 0) == resource.data.get('final_cents', 0))))
        // The booked mechanic may confirm, decline, complete, and attach an inspection report
        || (signedIn() && resource.data.mechanic_uid != '' && resource.data.mechanic_uid == request.auth.uid
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'confirmed_at', 'completed_at', 'cancelled_at', 'status_by', 'report', 'revision'])
            && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['revision'])
                || (request.resource.data.revision.status == 'pending'
                    && request.resource.data.revision.total_cents == request.resource.data.revision.labor_cents + request.resource.data.revision.parts_cents
                    && request.resource.data.revision.total_cents > 0 && request.resource.data.revision.total_cents <= 2000000
                    && !(resource.data.get('payment_status', '') in ['paid', 'charging', 'charge_now'])))
            && (request.resource.data.status == resource.data.status
                || (resource.data.status == 'pending' && request.resource.data.status in ['confirmed', 'cancelled'])
                || (resource.data.status == 'confirmed' && request.resource.data.status in ['completed', 'cancelled'])));
      allow delete: if isAdmin();
    }

    // Contact form: anyone can send a message, only an admin can read them.
    match /messages/{id} {
      allow create: if request.resource.data.status == 'new'
                    && request.resource.data.name is string    && request.resource.data.name.size()    <= 80
                    && request.resource.data.email is string   && request.resource.data.email.size()   <= 120
                    && request.resource.data.message is string && request.resource.data.message.size() <= 2000
                    && request.resource.data.created_at == request.time;
      allow read, update, delete: if isAdmin();
    }

    // Reviews: public to read. A customer may post one review per booking, only for their own
    // completed booking, and the review must name the mechanic that booking was with.
    match /reviews/{bookingId} {
      allow read: if true;
      allow create: if signedIn()
                    && request.resource.data.customer_id == request.auth.uid
                    && request.resource.data.booking_id == bookingId
                    && request.resource.data.rating is int
                    && request.resource.data.rating >= 1 && request.resource.data.rating <= 5
                    && request.resource.data.comment is string && request.resource.data.comment.size() <= 600
                    && get(/databases/$(database)/documents/bookings/$(bookingId)).data.customer_id == request.auth.uid
                    && get(/databases/$(database)/documents/bookings/$(bookingId)).data.status == 'completed'
                    && get(/databases/$(database)/documents/bookings/$(bookingId)).data.mechanic_slug == request.resource.data.mechanic_slug;
      allow update, delete: if isAdmin();
    }

    // One document per mechanic + day + time. Creating it fails if it already exists, which is what
    // stops two customers booking the same mechanic at the same time. No personal details inside.
    match /slots/{slotId} {
      allow read: if true;
      allow create: if signedIn()
                    && request.resource.data.customer_id == request.auth.uid
                    && request.resource.data.mechanic_doc is string
                    && request.resource.data.date_iso is string
                    && request.resource.data.time is string;
      allow update: if false;
      allow delete: if isAdmin() || (signedIn() && (resource.data.customer_id == request.auth.uid
                                                    || (resource.data.mechanic_uid != '' && resource.data.mechanic_uid == request.auth.uid)));
    }

    // ── Quote requests ──
    // Which mechanic profile a signed-in mechanic runs (used to see open requests and to quote)
    match /mech_index/{uid} {
      allow read: if isAdmin() || (signedIn() && request.auth.uid == uid);
      allow write: if signedIn() && request.auth.uid == uid
                   && get(/databases/$(database)/documents/mechanics/$(request.resource.data.mechanic_doc)).data.owner_uid == uid;
    }

    // Public part of a request: no address, no phone, no full name
    match /requests/{rid} {
      allow read: if isAdmin() || (signedIn() && (resource.data.customer_id == request.auth.uid
                     || request.auth.uid in resource.data.invited_uids
                     || (resource.data.mode == 'open' && exists(/databases/$(database)/documents/mech_index/$(request.auth.uid)))));
      allow create: if signedIn() && request.resource.data.customer_id == request.auth.uid
                    && request.resource.data.status == 'open'
                    && request.resource.data.mode in ['open', 'picked']
                    && request.resource.data.invited_uids is list && request.resource.data.invited_uids.size() <= 3
                    && request.resource.data['service'] is string && request.resource.data['service'].size() <= 300
                    && (!('photos' in request.resource.data) || (request.resource.data.photos is list && request.resource.data.photos.size() <= 3))
                    && !('accepted_mechanic_uid' in request.resource.data)
                    && request.resource.data.created_at == request.time;
      allow update: if isAdmin() || (signedIn() && resource.data.customer_id == request.auth.uid
                    && resource.data.status == 'open'
                    && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'accepted_mechanic_uid', 'accepted_quote_uid', 'booking_id'])
                    && request.resource.data.status in ['cancelled', 'accepted']);
      allow delete: if isAdmin();

      match /quotes/{muid} {
        function req() { return get(/databases/$(database)/documents/requests/$(rid)).data; }
        function validQuote() {
          return request.resource.data.mechanic_uid == muid
            && request.resource.data.mechanic_doc == get(/databases/$(database)/documents/mech_index/$(muid)).data.mechanic_doc
            && request.resource.data.status in ['sent', 'withdrawn']
            && request.resource.data.total_cents is int
            && request.resource.data.total_cents == request.resource.data.labor_cents + request.resource.data.parts_cents
            && request.resource.data.get('kind', 'job') in ['job', 'diagnosis']
            && (!('book_hours' in request.resource.data) || (request.resource.data.book_hours is number && request.resource.data.book_hours > 0 && request.resource.data.book_hours <= 40))
            && (request.resource.data.total_cents >= 500 || (request.resource.data.get('kind', 'job') == 'diagnosis' && request.resource.data.total_cents >= 0))
            && request.resource.data.total_cents <= 2000000
            && (!paymentsOn() || get(/databases/$(database)/documents/mechanics/$(request.resource.data.mechanic_doc)).data.get('payouts_ready', false) == true);
        }
        function mayQuote() {
          return signedIn() && request.auth.uid == muid
            && exists(/databases/$(database)/documents/mech_index/$(muid))
            && req().status == 'open'
            && (req().mode == 'open' || muid in req().invited_uids)
            && req().customer_id != muid;
        }
        allow read: if isAdmin() || (signedIn() && (request.auth.uid == muid || req().customer_id == request.auth.uid));
        allow create: if mayQuote() && validQuote();
        allow update: if (mayQuote() && validQuote() && resource.data.status in ['sent', 'withdrawn'])
                      // the customer accepts or declines
                      || (signedIn() && req().customer_id == request.auth.uid
                          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status'])
                          && request.resource.data.status in ['accepted', 'declined']);
        allow delete: if isAdmin();
      }
    }

    // Exact address, phone and full name: the customer, admins, and only the mechanic whose quote was accepted
    match /request_private/{rid} {
      allow create: if signedIn() && request.resource.data.customer_id == request.auth.uid
                    && getAfter(/databases/$(database)/documents/requests/$(rid)).data.customer_id == request.auth.uid
                    && request.resource.data.address is string && request.resource.data.address.size() <= 300;
      allow read: if isAdmin() || (signedIn() && (resource.data.customer_id == request.auth.uid
                    || get(/databases/$(database)/documents/requests/$(rid)).data.get('accepted_mechanic_uid', '') == request.auth.uid));
      allow update: if signedIn() && resource.data.customer_id == request.auth.uid
                    && request.resource.data.customer_id == request.auth.uid;
    }

    // Insurance certificate a mechanic uploads for you to check. Only that mechanic and admins can see it.
    match /insurance_docs/{mechDoc} {
      function owns() { return signedIn() && get(/databases/$(database)/documents/mechanics/$(mechDoc)).data.get('owner_uid', '') == request.auth.uid; }
      allow read: if isAdmin() || owns();
      allow write: if isAdmin() || (owns()
                    && request.resource.data.image is string && request.resource.data.image.size() <= 400000
                    && request.resource.data.expires is string && request.resource.data.expires.size() == 10
                    && request.resource.data.keys().hasOnly(['image', 'expires', 'insurer', 'mechanic_name', 'uploaded_at']));
    }

    // stripe_customers / booking_payments: server only (no client rule = no access)

    match /customer_profiles/{uid} {
      allow read, write: if signedIn() && request.auth.uid == uid;
    }
  }
}
